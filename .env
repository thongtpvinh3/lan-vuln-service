# RabbitMQ
RABBITMQ_URL=amqp://admin:123456@rabbitmq.thong.stream:5672/%2F

# Exchange

# Consumer

# Publisher
RABBITMQ_COMPLETED_STEP_KEY=assessment.step.completed
RABBITMQ_COMPLETED_STAGE_KEY=assessment.stage.completed

# Supported Event Types
RABBITMQ_LIST_EVENT_TYPE=platform.assessment.stage.requested,platform.scan.cancelled

# Dead Letter

# PostgreSQL
DATABASE_URL=postgresql+psycopg://scanner:scanner@postgres.thong.stream:5432/vuln
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_CONNECT_TIMEOUT=10

DB_ECHO=false

# Scope Service
SCOPE_CHECK_URL=http://localhost:8000/scope/check

# NVD
NVD_API_KEY=
NVD_CACHE_HOURS=24
NVD_REQUEST_INTERVAL=7
CPE_AUTO_FETCH_ENABLED=true
CPE_FETCH_INTERVAL_HOURS=24
CPE_FETCH_LIMIT_PER_PRODUCT=500

# CompilanceAsCode

MISCONFIG_RULE_FETCH_ENABLED=true
MISCONFIG_RULE_GIT_URL=https://github.com/ComplianceAsCode/content.git
MISCONFIG_RULE_GIT_REF=master
MISCONFIG_RULE_WORKSPACE=./data/complianceascode
MISCONFIG_RULE_SYNC_INTERVAL_HOURS=24
MISCONFIG_RULE_BATCH_SIZE=200
MISCONFIG_RULE_GIT_TIMEOUT_SECONDS=300

# Flask
FLASK_HOST=127.0.0.1
FLASK_PORT=8082

# Generated by the matching Platform release; keep broker credentials separate.
RABBITMQ_CLIENT_ENV_FILE=assessment.messaging.env
